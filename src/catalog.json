{
  "version": 1,
  "note": "Preset endpoints for `keyflip provider add <id>`. Base URLs are taken from each vendor's own docs (see docs); model names are the vendor's current Claude-Code-facing defaults and WILL drift — `keyflip provider models <id>` queries the live list. compat=anthropic means Claude Code can be pointed at it directly; compat=openai means it speaks the OpenAI chat API and needs an Anthropic-compatible gateway/shim (or is for router/cost use only).",
  "providers": [
    {
      "id": "anthropic",
      "name": "Anthropic (API key)",
      "category": "official",
      "baseUrl": "https://api.anthropic.com",
      "compat": "anthropic",
      "authScheme": "api-key",
      "models": {},
      "docs": "https://docs.anthropic.com/en/api"
    },
    {
      "id": "zai",
      "name": "Z.AI (GLM, intl)",
      "category": "china",
      "baseUrl": "https://api.z.ai/api/anthropic",
      "compat": "anthropic",
      "authScheme": "bearer",
      "models": { "default": "glm-4.6", "smallFast": "glm-4.5-air", "haiku": "glm-4.5-air" },
      "docs": "https://docs.z.ai/scenario-example/develop-tools/claude"
    },
    {
