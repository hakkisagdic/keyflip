---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { t } from '../i18n';

const locale = 'en';
const trans = t(locale);

const tiers = [
  {
    name: 'Free',
    price: '$0',
    period: 'forever',
    description: 'Open source, no limits on core features.',
    features: [
      'Account switching (unlimited)',
      'Provider routing',
      'Failover proxy',
      'Session search & resume',
      'Backup & migrate',
      'Foreign session import',
      'Base MCP surface',
      'CLI + interactive menu',
    ],
    highlighted: false,
    badge: null,
  },
  {
    name: 'Pro',
    price: '$8-12',
    period: '/month',
    description: 'Scale, automation, and intelligence for power users.',
    features: [
      'Everything in Free',
      'Fleet management',
      'Orchestrator / jobs / fanout',
      'Cost intelligence & prediction',
      'Budgets & alerts',
      'Auto-switch (background service)',
      'Router + cache',
      'Priority support',
    ],
    highlighted: true,
    badge: 'Coming Soon',
  },
  {
    name: 'Team',
    price: '$6-10',
    period: '/seat/month',
    description: 'Secure collaboration for teams and orgs.',
    features: [
      'Everything in Pro',
      'Encrypted team pool (RBAC)',
      'Policy engine',
      'Vault backends (1Password/Bitwarden/HashiCorp)',
      'Swarm (own-fleet exec)',
      'Audit export',
      'SSO support',
    ],
    highlighted: false,
    badge: 'Coming Soon',
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    period: '',
    description: 'Self-host, custom policy, and dedicated support.',
    features: [
      'Everything in Team',
      'Self-host license issuer',
      'Custom policy rules',
      'Priority support + SLA',
      'Procurement & invoicing',
      'Dedicated onboarding',
    ],
    highlighted: false,
    badge: 'Coming Soon',
  },
];
---

<BaseLayout title="Pricing" locale={locale} currentPath="/pricing">
  <PageHeader title={trans.pricing.title} subtitle={trans.pricing.subtitle} />

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {tiers.map((tier) => (
          <div class={`relative flex flex-col p-6 rounded-xl border ${tier.highlighted ? 'border-primary-500 dark:border-primary-400 shadow-xl ring-2 ring-primary-500/20' : 'border-surface-200 dark:border-surface-800'} bg-white dark:bg-surface-900`}>
            {tier.badge && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 text-xs font-semibold bg-primary-600 text-white rounded-full">
                {tier.badge}
              </span>
            )}
            <h3 class="text-xl font-bold text-surface-900 dark:text-surface-100">{tier.name}</h3>
            <div class="mt-4 flex items-baseline">
              <span class="text-3xl font-extrabold text-surface-900 dark:text-surface-50">{tier.price}</span>
              {tier.period && <span class="ml-1 text-sm text-surface-700 dark:text-surface-300">{tier.period}</span>}
            </div>
            <p class="mt-3 text-sm text-surface-700 dark:text-surface-300">{tier.description}</p>
            <ul class="mt-6 space-y-3 flex-1">
              {tier.features.map((f) => (
                <li class="flex items-start gap-2 text-sm text-surface-700 dark:text-surface-300">
                  <svg class="w-4 h-4 text-green-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M5 13l4 4L19 7" />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
            <div class="mt-6">
              {tier.name === 'Free' ? (
                <a href="/docs/installation" class="block w-full text-center px-4 py-2 text-sm font-semibold text-primary-600 dark:text-primary-400 border border-primary-600 dark:border-primary-400 rounded-lg hover:bg-primary-50 dark:hover:bg-primary-950 transition-colors">
                  Install Now
                </a>
              ) : (
                <button disabled class="block w-full text-center px-4 py-2 text-sm font-semibold text-surface-400 dark:text-surface-600 border border-surface-200 dark:border-surface-700 rounded-lg cursor-not-allowed">
                  Coming Soon
                </button>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-16 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-center text-surface-900 dark:text-surface-50 mb-6">Licensing Philosophy</h2>
        <div class="p-6 bg-surface-100 dark:bg-surface-800 rounded-xl space-y-4 text-surface-700 dark:text-surface-300">
          <p><strong>No phone-home:</strong> License verification is offline (Ed25519 signature). Works air-gapped.</p>
          <p><strong>Free tier stays genuinely useful:</strong> The core switch/manage workflow remains free and open source (MIT).</p>
          <p><strong>Zero telemetry by default:</strong> No data collection unless you explicitly opt in.</p>
          <p><strong>Zero runtime dependencies preserved:</strong> The licensing primitive uses only <code>node:crypto</code>.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
