---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CodeBlock from '../../components/CodeBlock.astro';
---

<BaseLayout title="Kullanim Senaryolari" locale="tr" currentPath="/tr/use-cases">
  <PageHeader title="Kullanim Senaryolari" subtitle="keyflip icin gercek dunya senaryolari ve is akislari" />

  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

      <div class="p-6 bg-primary-50 dark:bg-primary-950/30 border border-primary-200 dark:border-primary-800 rounded-xl">
        <h2 class="text-xl font-bold text-surface-900 dark:text-surface-100 mb-3">Zihinsel Model</h2>
        <ul class="list-disc pl-6 text-surface-700 dark:text-surface-300 space-y-2">
          <li><strong>Dort giris yuzeyi:</strong> CLI (Claude Code), Masaustu uygulama, Tarayici (claude.ai), Uzanti koeprusu</li>
          <li><strong>Hesaplar ve Saglayicilar:</strong> Hesap = kim faturalanir (OAuth); Saglayici = istekler nereye gider (API ucnoktasi)</li>
          <li><strong>Oturumlar hesaptan bagimsizdir:</strong> Transkriptler hicbir hesaba ait degil -- her zaman tutmak/tasinmak/birlestirmek guvenlidir</li>
          <li><strong>Guvenlik kurallari:</strong> Asla onaysiz gecis yapmaz; sirlar sadece isletim sistemi deposunda; mutasyonlar seri ve islemsel</li>
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-surface-900 dark:text-surface-50 mb-6">Ilk Calistirma: Hesap Yakalama</h2>
        <div class="space-y-4">
          <div class="p-5 bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800 rounded-xl">
            <h3 class="font-semibold text-surface-900 dark:text-surface-100">Tam Rehberli Baslatma</h3>
            <p class="text-sm text-surface-700 dark:text-surface-300 mt-2">Sifirdan birden fazla hesap kurun.</p>
            <CodeBlock code="keyflip onboard" />
          </div>
          <div class="p-5 bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800 rounded-xl">
            <h3 class="font-semibold text-surface-900 dark:text-surface-100">Hafif Sihirbaz</h3>
            <p class="text-sm text-surface-700 dark:text-surface-300 mt-2">Mevcut girisi yakala, sonra her yeniyi otomatik algilar.</p>
            <CodeBlock code="keyflip setup" />
          </div>
          <div class="p-5 bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800 rounded-xl">
            <h3 class="font-semibold text-surface-900 dark:text-surface-100">Tek Seferlik Yakalama</h3>
            <CodeBlock code={`keyflip add              # mevcut girisi kaydet
keyflip add work         # "work" olarak adlandir
keyflip add work --app   # sadece masaustu uygulamasi`} />
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-surface-900 dark:text-surface-50 mb-6">Gunluk Gecis</h2>
        <div class="space-y-4">
          <div class="p-5 bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800 rounded-xl">
            <h3 class="font-semibold text-surface-900 dark:text-surface-100">Kisisel + Is hesaplari</h3>
            <p class="text-sm text-surface-700 dark:text-surface-300 mt-2">Gun boyunca kisisel Pro ve sirket Team hesaplari arasinda gecis yapin.</p>
            <CodeBlock code={`keyflip work      # sabah: ise gec
keyflip personal  # aksam: kisiyele geri don`} />
          </div>
          <div class="p-5 bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800 rounded-xl">
            <h3 class="font-semibold text-surface-900 dark:text-surface-100">Kota Rotasyonu</h3>
            <p class="text-sm text-surface-700 dark:text-surface-300 mt-2">Hiz sinirini astiniz mi? Kotasi olan sonraki hesaba donun.</p>
            <CodeBlock code="keyflip next --strategy best" />
          </div>
          <div class="p-5 bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800 rounded-xl">
            <h3 class="font-semibold text-surface-900 dark:text-surface-100">Paralel Calisma</h3>
            <p class="text-sm text-surface-700 dark:text-surface-300 mt-2">Farkli terminallerde farkli hesaplari ayni anda calistirin.</p>
            <CodeBlock code={`# Terminal 1: is hesabi
keyflip run work

# Terminal 2: kisisel hesap (varsayilan)
claude`} />
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-surface-900 dark:text-surface-50 mb-6">Cihaz Transferi</h2>
        <div class="space-y-4">
          <div class="p-5 bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800 rounded-xl">
            <h3 class="font-semibold text-surface-900 dark:text-surface-100">Yeni Makine Kurulumu</h3>
            <p class="text-sm text-surface-700 dark:text-surface-300 mt-2">Tum hesaplari ve ayarlari yeni cihaza saniyeler icinde aktarin.</p>
            <CodeBlock code={`# Eski makine:
keyflip transfer serve --qr

# Yeni makine (QR tarayin veya kod yazin):
keyflip transfer pull --code ABC123`} />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
