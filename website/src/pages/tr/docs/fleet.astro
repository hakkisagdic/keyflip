---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
---

<BaseLayout title="Filo ve Transfer" locale="tr" currentPath="/tr/docs/fleet">
  <PageHeader title="Filo ve Transfer" subtitle="Birden fazla makineyi koordine edin ve cihazlar arasi hesap aktarin" />

  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <h2 class="text-2xl font-bold text-surface-900 dark:text-surface-50 mb-4">Filo Kontrolu</h2>
      <p class="text-surface-700 dark:text-surface-300 mb-4">
        Filo, makineleri sifrelenmis paylasimli klasor uzerinden koordine eder. Her makine koken dogrulamasi icin bir Ed25519 imzalama anahtarina sahiptir.
      </p>
      <CodeBlock code={`keyflip fleet init --dir <paylasimli-klasor>   # kontrol duzlemine bagla
keyflip fleet push [--with-secrets]            # durumu yayinla + komutlari uygula
keyflip fleet status                           # her makineyi gor
keyflip fleet switch <makine> <hesap>          # uzak makine hesabini degistir
keyflip fleet send-account <hesap> --to <m>    # bir hesabi dagit
keyflip fleet collect                          # filodan tum hesaplari topla
keyflip fleet keys                             # imzalama anahtari parmak izlerini denetle
keyflip fleet trust <makine>                   # yeniden anahtarlamadan sonra yeniden sabitle`} />

      <h2 class="text-2xl font-bold text-surface-900 dark:text-surface-50 mb-4 mt-10">LAN Transferi</h2>
      <p class="text-surface-700 dark:text-surface-300 mb-4">Tek kullanimlik kod + istege bagli QR, esler arasi sifrelenmis akis:</p>
      <CodeBlock code={`# Makine A (gonderen):
keyflip transfer serve [--qr]

# Makine B (alan):
keyflip transfer pull --code X

# Ters yon:
keyflip transfer serve --receive     # B bekler
keyflip transfer push <host> --code X  # A gonderir`} />

      <h2 class="text-2xl font-bold text-surface-900 dark:text-surface-50 mb-4 mt-10">Internet Rolesyonu (Sifir Bilgi)</h2>
      <p class="text-surface-700 dark:text-surface-300 mb-4">
        Internet uzerinden ayni kod deneyimi. Role sadece sifrelenmis metin tutar. Kodun anahtar yarisi asla roleye ulasmaz. Tek kullanimlik: paket alindiginda silinir.
      </p>
      <CodeBlock code={`# Senkron klasor uzerinden (Dropbox/iCloud/Drive):
keyflip transfer serve --relay ~/Dropbox/kf
keyflip transfer pull --relay ~/Dropbox/kf --code <randevu>-<anahtar>

# Kendi rolenizi barindirin:
keyflip transfer relay --host 0.0.0.0 --auth-user ben --auth-pass-file sifre.txt`} />
    </div>
  </section>
</BaseLayout>
