---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { t } from '../../i18n';
import {
  checkoutOptions,
  cycleLabel,
  planPrice,
  providerLabel,
  regionLabel,
  salesOpen,
} from '../../checkout';

const locale = 'tr';
const trans = t(locale);
const open = salesOpen();

const tiers = [
  {
    id: 'free',
    name: 'Ücretsiz',
    price: '$0',
    period: 'sonsuza kadar',
    description: 'Açık kaynak, temel özellikler sınırsız.',
    features: [
      'Hesap değiştirme (sınırsız)',
      'Sağlayıcı yönlendirme',
      'Yedekleme proxy\'si',
      'Oturum arama ve devam',
      'Yedekleme ve göç',
      'Yabancı oturum aktarımı',
      'Temel MCP yüzeyi',
      'CLI + interaktif menü',
    ],
    highlighted: false,
    badge: null,
  },
  {
    id: 'pro',
    name: 'Pro',
    price: '$8-12',
    period: '/ay',
    description: 'Güçlü kullanıcılar için ölçek, otomasyon ve zeka.',
    features: [
      'Ücretsiz\'deki her şey',
      'Filo yönetimi',
      'Orkestratör / işler / dağılım',
      'Maliyet zekası ve tahmin',
      'Bütçeler ve uyarılar',
      'Otomatik geçiş (arka plan servisi)',
      'Yönlendirici + önbellek',
      'Öncelikli destek',
    ],
    highlighted: true,
    badge: 'Yakında',
  },
  {
    id: 'team',
    name: 'Takım',
    price: '$6-10',
    period: '/kişi/ay',
    description: 'Takımlar ve organizasyonlar için güvenli iş birliği.',
    features: [
      'Pro\'daki her şey',
      'Şifrelenmiş takım havuzu (RBAC)',
      'Politika motoru',
      'Vault arka uçları (1Password/Bitwarden/HashiCorp)',
      'Swarm (kendi filo yürüt)',
      'Denetim dışa aktarımı',
      'SSO desteği',
    ],
    highlighted: false,
    badge: 'Yakında',
  },
  {
    id: 'enterprise',
    name: 'Kurumsal',
    price: 'Özel',
    period: '',
    description: 'Kendi barındırma, özel politika ve adanmış destek.',
    features: [
      'Takım\'daki her şey',
      'Kendi barındırma lisans düzenleyici',
      'Özel politika kuralları',
      'Öncelikli destek + SLA',
      'Tedarik ve faturalandırma',
      'Adanmış başlatma',
    ],
    highlighted: false,
    badge: 'Yakında',
  },
];

// Her ödeme seçeneği için bir düğme. Ödeme hesapları henüz yokken liste boş
// kalır ve sayfa alışılmış "yakında" düğmesini gösterir.
const optionsFor = (id: string) => checkoutOptions(id);
---

<BaseLayout title="Fiyatlandırma" locale={locale} currentPath="/tr/pricing">
  <PageHeader title={trans.pricing.title} subtitle={trans.pricing.subtitle} />

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {tiers.map((tier) => {
          const options = optionsFor(tier.id);
          const price = planPrice(tier.id) || tier.price;
          return (
            <div class={`relative flex flex-col p-6 rounded-xl border ${tier.highlighted ? 'border-primary-500 dark:border-primary-400 shadow-xl ring-2 ring-primary-500/20' : 'border-surface-200 dark:border-surface-800'} bg-white dark:bg-surface-900`}>
              {tier.badge && !open && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 text-xs font-semibold bg-primary-600 text-white rounded-full">
                  {tier.badge}
                </span>
              )}
              <h3 class="text-xl font-bold text-surface-900 dark:text-surface-100">{tier.name}</h3>
              <div class="mt-4 flex items-baseline">
                <span class="text-3xl font-extrabold text-surface-900 dark:text-surface-50">{price}</span>
                {tier.period && <span class="ml-1 text-sm text-surface-700 dark:text-surface-300">{tier.period}</span>}
              </div>
              <p class="mt-3 text-sm text-surface-700 dark:text-surface-300">{tier.description}</p>
              <ul class="mt-6 space-y-3 flex-1">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2 text-sm text-surface-700 dark:text-surface-300">
                    <svg class="w-4 h-4 text-green-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M5 13l4 4L19 7" />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
              <div class="mt-6 space-y-2">
                {tier.id === 'free' ? (
                  <a href="/tr/docs/installation" class="block w-full text-center px-4 py-2 text-sm font-semibold text-primary-600 dark:text-primary-400 border border-primary-600 dark:border-primary-400 rounded-lg hover:bg-primary-50 dark:hover:bg-primary-950 transition-colors">
                    Hemen Kur
                  </a>
                ) : options.length > 0 ? (
                  options.map((opt) => (
                    <a
                      href={opt.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block w-full text-center px-4 py-2 text-sm font-semibold text-white bg-primary-600 hover:bg-primary-700 dark:bg-primary-500 dark:hover:bg-primary-600 rounded-lg transition-colors"
                    >
                      {tier.name} satın al — {cycleLabel(opt.cycle, locale)} · {regionLabel(opt.region, locale)}
                      <span class="block text-xs font-normal opacity-80">{providerLabel(opt.provider)}</span>
                    </a>
                  ))
                ) : (
                  <button disabled class="block w-full text-center px-4 py-2 text-sm font-semibold text-surface-400 dark:text-surface-600 border border-surface-200 dark:border-surface-700 rounded-lg cursor-not-allowed">
                    Yakında
                  </button>
                )}
              </div>
            </div>
          );
        })}
      </div>

      <div class="mt-10 text-center">
        <a href="/tr/license" class="text-sm font-semibold text-primary-600 dark:text-primary-400 hover:underline">
          Zaten bir plan aldınız mı? Lisansınızı etkinleştirin →
        </a>
      </div>

      <div class="mt-16 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-center text-surface-900 dark:text-surface-50 mb-6">Lisans Felsefesi</h2>
        <div class="p-6 bg-surface-100 dark:bg-surface-800 rounded-xl space-y-4 text-surface-700 dark:text-surface-300">
          <p><strong>Telefona dönmez:</strong> Lisans doğrulaması çevrimdışıdır (Ed25519 imzası). İnternet olmadan da çalışır.</p>
          <p><strong>Ücretsiz katman gerçekten işe yarar:</strong> Çekirdek değiştirme/yönetme akışı ücretsiz ve açık kaynak kalır (MIT).</p>
          <p><strong>Varsayılan sıfır telemetri:</strong> Açıkça opt-in olmadıkça veri toplanmaz.</p>
          <p><strong>Sıfır çalışma zamanı bağımlılığı korunur:</strong> Lisanslama yalnızca <code>node:crypto</code> kullanır.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
