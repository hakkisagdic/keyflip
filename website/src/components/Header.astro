---
import type { Locale } from '../i18n';
import { getNavigation, getAlternateLocalePath, t } from '../i18n';
import DarkModeToggle from './DarkModeToggle.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const nav = getNavigation(locale);
const trans = t(locale);
const alternatePath = getAlternateLocalePath(currentPath, locale);
const alternateLabel = locale === 'en' ? 'TR' : 'EN';
---

<header class="sticky top-0 z-50 w-full border-b border-surface-200 dark:border-surface-800 bg-surface-50/80 dark:bg-surface-950/80 backdrop-blur-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={locale === 'tr' ? '/tr/' : '/'} class="flex items-center gap-2 font-bold text-xl text-primary-600 dark:text-primary-400">
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M13.8 12H3" />
        </svg>
        keyflip
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1">
        {nav.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class="px-3 py-2 text-sm font-medium text-surface-700 dark:text-surface-300 hover:text-primary-600 dark:hover:text-primary-400 rounded-md hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors"
            >
              {item.label}
            </a>
            {item.children && (
              <div class="absolute left-0 top-full mt-1 w-48 bg-surface-50 dark:bg-surface-900 border border-surface-200 dark:border-surface-700 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <div class="py-1">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block px-4 py-2 text-sm text-surface-700 dark:text-surface-300 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-surface-100 dark:hover:bg-surface-800"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- Right side -->
      <div class="flex items-center gap-2">
        <DarkModeToggle />

        <!-- Language switch -->
        <a
          href={alternatePath}
          class="px-3 py-1.5 text-sm font-medium border border-surface-200 dark:border-surface-700 rounded-md hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors"
          title={trans.nav.language}
        >
          {alternateLabel}
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/hakkisagdic/keyflip"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-surface-700 dark:text-surface-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 text-surface-700 dark:text-surface-300 hover:text-primary-600 transition-colors"
          aria-label={trans.nav.menu}
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-surface-200 dark:border-surface-800 bg-surface-50 dark:bg-surface-950">
    <nav class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      {nav.map((item) => (
        <>
          <a
            href={item.href}
            class="block px-3 py-2 text-sm font-medium text-surface-700 dark:text-surface-300 hover:text-primary-600 dark:hover:text-primary-400 rounded-md hover:bg-surface-100 dark:hover:bg-surface-800"
          >
            {item.label}
          </a>
          {item.children && item.children.map((child) => (
            <a
              href={child.href}
              class="block pl-6 px-3 py-2 text-sm text-surface-700 dark:text-surface-300 hover:text-primary-600 dark:hover:text-primary-400 rounded-md hover:bg-surface-100 dark:hover:bg-surface-800"
            >
              {child.label}
            </a>
          ))}
        </>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
