---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const trans = t(locale);
---

<footer class="border-t border-surface-200 dark:border-surface-800 bg-surface-100 dark:bg-surface-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <a href={locale === 'tr' ? '/tr/' : '/'} class="text-xl font-bold text-primary-600 dark:text-primary-400">
          keyflip
        </a>
        <p class="mt-2 text-sm text-surface-700 dark:text-surface-300">
          {trans.site.tagline}
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-surface-900 dark:text-surface-100">
          {locale === 'en' ? 'Resources' : 'Kaynaklar'}
        </h3>
        <ul class="mt-3 space-y-2">
          <li><a href={locale === 'tr' ? '/tr/docs' : '/docs'} class="text-sm text-surface-700 dark:text-surface-300 hover:text-primary-600 dark:hover:text-primary-400">{locale === 'en' ? 'Documentation' : 'Dokümantasyon'}</a></li>
          <li><a href={locale === 'tr' ? '/tr/docs/cli-reference' : '/docs/cli-reference'} class="text-sm text-surface-700 dark:text-surface-300 hover:text-primary-600 dark:hover:text-primary-400">{locale === 'en' ? 'CLI Reference' : 'CLI Referansı'}</a></li>
          <li><a href="https://github.com/hakkisagdic/keyflip" target="_blank" rel="noopener noreferrer" class="text-sm text-surface-700 dark:text-surface-300 hover:text-primary-600 dark:hover:text-primary-400">GitHub</a></li>
          <li><a href="https://www.npmjs.com/package/keyflip" target="_blank" rel="noopener noreferrer" class="text-sm text-surface-700 dark:text-surface-300 hover:text-primary-600 dark:hover:text-primary-400">npm</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-surface-900 dark:text-surface-100">
          {locale === 'en' ? 'Legal' : 'Yasal'}
        </h3>
        <ul class="mt-3 space-y-2">
          <li><span class="text-sm text-surface-700 dark:text-surface-300">{trans.footer.license}</span></li>
          <li><span class="text-sm text-surface-700 dark:text-surface-300">{trans.footer.madeBy} <a href="https://github.com/hakkisagdic" target="_blank" rel="noopener noreferrer" class="text-primary-600 dark:text-primary-400 hover:underline">Hakki Sagdic</a></span></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-surface-200 dark:border-surface-800">
      <p class="text-xs text-center text-surface-700 dark:text-surface-400">
        {trans.footer.notAffiliated}
      </p>
    </div>
  </div>
</footer>
