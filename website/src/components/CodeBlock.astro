---
interface Props {
  code: string;
  lang?: string;
  title?: string;
}

const { code, lang = 'bash', title } = Astro.props;
---

<div class="rounded-lg overflow-hidden border border-surface-200 dark:border-surface-800 my-4">
  {title && (
    <div class="px-4 py-2 bg-surface-100 dark:bg-surface-800 border-b border-surface-200 dark:border-surface-700">
      <span class="text-xs font-medium text-surface-700 dark:text-surface-300">{title}</span>
    </div>
  )}
  <pre class="p-4 bg-surface-900 dark:bg-surface-950 text-surface-100 overflow-x-auto"><code class={`language-${lang}`} set:html={code} /></pre>
</div>
